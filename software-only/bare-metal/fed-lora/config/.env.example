# ==============================================================================
# Edge-to-Cloud Federated Learning (Fed-LoRA) PoC - Environment Configuration
# ==============================================================================
# Template file containing fake values for sensitive tokens/secret keys.
# Copy to `.env` locally (outside the repository) and populate with real secrets.

# --- GCP Project & Regional Control Plane ---
PROJECT_ID="YOUR_PROJECT_ID"
REGION="us-central1"
ZONE="us-central1-b"

# --- Custom VPC & Subnet Configuration ---
VPC_NAME="YOUR_VPC_NAME"
SUBNET_NAME="YOUR_SUBNET_NAME"
SUBNET_CIDR="10.200.0.0/24"
ADMIN_WS_SUBNET="YOUR_ADMIN_SUBNET_NAME"
ADMIN_WS_CIDR="10.0.0.0/24"

# --- GDC Software-Only Release & Admin Workstation ---
BMCTL_VERSION="1.36.0-gke.532"
ADMIN_VM_NAME="YOUR_ADMIN_VM_NAME"
ADMIN_VM_IP="10.0.0.2"

# --- Store 1 Edge Cluster (YOUR_STORE_1_CLUSTER) ---
STORE1_CLUSTER_NAME="YOUR_STORE_1_CLUSTER"
STORE1_VM_NAME="YOUR_STORE_1_NODE"
STORE1_VM_IP="10.200.0.11"
STORE1_ALIAS_RANGES="10.200.0.128/28"
STORE1_CP_VIP="10.200.0.129"
STORE1_INGRESS_VIP="10.200.0.130"
STORE1_LB_POOL="10.200.0.131-10.200.0.142"
STORE1_VLLM_LB_IP="10.200.0.131"

# --- Store 2 Edge Cluster (YOUR_STORE_2_CLUSTER) ---
STORE2_CLUSTER_NAME="YOUR_STORE_2_CLUSTER"
STORE2_VM_NAME="YOUR_STORE_2_NODE"
STORE2_VM_IP="10.200.0.12"
STORE2_ALIAS_RANGES="10.200.0.160/28"
STORE2_CP_VIP="10.200.0.161"
STORE2_INGRESS_VIP="10.200.0.162"
STORE2_LB_POOL="10.200.0.162-10.200.0.174"
STORE2_VLLM_LB_IP="10.200.0.163"

# --- Central GKE Aggregator Cluster ---
GKE_CLUSTER_NAME="YOUR_AGGREGATOR_CLUSTER"
FLWR_SERVER_INTERNAL_LB_IP="10.200.0.50"

# --- Cloud Storage ---
GCS_BUCKET_URI="gs://YOUR_GCS_BUCKET"

# --- Authentication & Secrets (FAKE EXAMPLE VALUES) ---
# Hugging Face token with read access to google/gemma-4-E2B-it (used for fed-lora-poc/hf-token-secret)
HF_TOKEN="your-hf-token"
# Artifact Registry pull credentials for GDC Software-Only edge clusters (used for fed-lora-poc/ar-pull-secret)
AR_PULL_TOKEN="your-ar-pull-token"
AR_READER_KEY_FILE=""
