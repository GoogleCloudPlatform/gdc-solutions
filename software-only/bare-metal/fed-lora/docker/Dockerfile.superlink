# Pre-Baked Central Flower SuperLink & ServerApp Container
# Extends official flwr/superlink:1.36.0 with google-cloud-storage, safetensors,
# and numpy so Central GKE SuperLink starts in < 5s with zero runtime pip install.

FROM flwr/superlink:1.36.0

USER root

RUN (python3 -m pip --version || python3 -m ensurepip || (apt-get update && apt-get install -y --no-install-recommends python3-pip bash && rm -rf /var/lib/apt/lists/*)) \
    && (python3 -m pip install --no-cache-dir --break-system-packages \
          "flwr[rest]==1.36.0" \
          google-cloud-storage \
          safetensors \
          numpy \
          requests \
        || python3 -m pip install --no-cache-dir \
          "flwr[rest]==1.36.0" \
          google-cloud-storage \
          safetensors \
          numpy \
          requests) \
    && mkdir -p /root/.flwr /tmp/checkpoints /app/.flwr \
    && chmod -R 777 /root/.flwr /tmp/checkpoints /app/.flwr

ENV PYTHONUNBUFFERED=1
