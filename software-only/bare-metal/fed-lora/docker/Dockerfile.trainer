# Pre-Baked Edge QLoRA Trainer & Flower SuperExec Container
# Extends the Gemma 4 vLLM/PyTorch CUDA runtime with Flower 1.36.0, PEFT,
# bitsandbytes, datasets, google-cloud-storage, and safetensors, configured
# for non-root execution (uid=1000, gid=2000) sharing /mnt/models with vLLM.

FROM us-docker.pkg.dev/vertex-ai/vertex-vision-model-garden-dockers/pytorch-vllm-serve:gemma4

USER root

RUN rm -f /etc/pip.conf /root/.config/pip/pip.conf /etc/xdg/pip/pip.conf \
    && (python3 -m pip install --no-cache-dir --break-system-packages -i https://pypi.org/simple/ \
          "flwr[rest]==1.36.0" \
          peft \
          bitsandbytes \
          datasets \
          google-cloud-storage \
          safetensors \
          requests \
        || python3 -m pip install --no-cache-dir -i https://pypi.org/simple/ \
          "flwr[rest]==1.36.0" \
          peft \
          bitsandbytes \
          datasets \
          google-cloud-storage \
          safetensors \
          requests)

RUN (getent group 2000 || groupadd -g 2000 flwr) \
    && (id -u 1000 >/dev/null 2>&1 \
        && usermod -l flwr -g 2000 -d /home/flwr -m "$(id -nu 1000)" \
        || useradd -m -u 1000 -g 2000 -s /bin/bash flwr) \
    && mkdir -p /home/flwr/.flwr /home/flwr/.cache /tmp/edge-data \
    && chown -R 1000:2000 /home/flwr /tmp/edge-data \
    && chmod -R 2775 /home/flwr /tmp/edge-data

ENV HOME=/home/flwr \
    PYTHONUNBUFFERED=1 \
    PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

USER 1000:2000
WORKDIR /home/flwr

ENTRYPOINT ["flower-superexec"]
