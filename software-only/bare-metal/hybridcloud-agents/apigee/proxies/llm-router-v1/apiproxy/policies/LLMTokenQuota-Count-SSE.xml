<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<LLMTokenQuota continueOnError="true" enabled="true" name="LLMTokenQuota-Count-SSE" type="flexi">
  <DisplayName>LLM Token Budget Count (SSE EventFlow)</DisplayName>
  <SharedName>hybrid-agents-llm-budget</SharedName>
  <CountOnly>true</CountOnly>
  <Distributed>true</Distributed>
  <Synchronous>true</Synchronous>
  <Identifier ref="verifyapikey.VerifyAPIKey-1.client_id"/>
  <Allow count="500000" countRef="verifyapikey.VerifyAPIKey-1.apiproduct.llm_token_quota"/>
  <Interval>1</Interval>
  <TimeUnit>hour</TimeUnit>
  <LLMTokenUsageSource>{jsonPath('$.usage.total_tokens',response.event.current.data,false)}</LLMTokenUsageSource>
  <LLMModelSource>{resolved_llm_model}</LLMModelSource>
</LLMTokenQuota>
