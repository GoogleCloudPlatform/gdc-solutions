<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="local-vllm-sse">
  <PreFlow name="PreFlow">
    <Request>
      <Step><Name>AssignMessage-StripAuthLocalVLLM</Name></Step>
    </Request>
    <Response>
      <Step><Name>AssignMessage-SetLocalVLLMHeader</Name></Step>
    </Response>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows/>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response>
      <Step><Name>LLMTokenQuota-Count-SSE</Name></Step>
    </Response>
  </EventFlow>
  <HTTPTargetConnection>
    <Properties>
      <Property name="io.timeout.millis">120000</Property>
      <Property name="connect.timeout.millis">10000</Property>
    </Properties>
    <LoadBalancer>
      <Algorithm>RoundRobin</Algorithm>
      <Server name="gdcso-local-vllm"/>
      <MaxFailures>3</MaxFailures>
    </LoadBalancer>
    <Path>/v1</Path>
    <HealthMonitor>
      <IsEnabled>true</IsEnabled>
      <IntervalInSec>10</IntervalInSec>
      <HTTPMonitor>
        <Request>
          <UseTargetServerSSLInfo>true</UseTargetServerSSLInfo>
          <ConnectTimeoutInSec>5</ConnectTimeoutInSec>
          <SocketReadTimeoutInSec>10</SocketReadTimeoutInSec>
          <Port>443</Port>
          <Verb>GET</Verb>
          <Path>/health</Path>
        </Request>
        <SuccessResponse>
          <ResponseCode>200</ResponseCode>
        </SuccessResponse>
      </HTTPMonitor>
    </HealthMonitor>
  </HTTPTargetConnection>
</TargetEndpoint>
