<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="vertex-gemini">
  <FaultRules>
    <FaultRule name="VertexOrModelArmorOutageFailover">
      <Condition>((response.status.code = 429) or (response.status.code &gt;= 500) or (response.status.code = 404) or (fault.name = "ErrorResponseCode") or (fault.name = "ModelArmorAPIFailed") or (fault.name = "ModelArmorTemplateNameExtractionFailed") or (fault.name = "InternalError") or (fault.name = "UnexpectedError")) and (fault.name != "FilterMatched")</Condition>
      <Step><Name>ServiceCallout-FailoverLocalVLLM</Name></Step>
      <Step><Name>AssignMessage-UseFailoverResponse</Name></Step>
      <Step><Name>LLMTokenQuota-Count</Name></Step>
      <Step><Name>JS-SetQuotaHeaders</Name></Step>
      <Step><Name>DataCapture-FinOps</Name></Step>
    </FaultRule>
  </FaultRules>
  <PreFlow name="PreFlow">
    <Request>
      <Step><Name>JS-PrepareCloudBurstPayload</Name></Step>
      <Step>
        <Name>SanitizeUserPrompt-CloudBurst</Name>
        <Condition>proxy.pathsuffix MatchesPath "/chat/completions"</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step><Name>AssignMessage-SetCloudBurstHeader</Name></Step>
      <Step>
        <Name>JS-ExtractCloudBurstResponse</Name>
        <Condition>proxy.pathsuffix MatchesPath "/chat/completions"</Condition>
      </Step>
      <Step>
        <Name>SanitizeModelResponse-CloudBurst</Name>
        <Condition>proxy.pathsuffix MatchesPath "/chat/completions"</Condition>
      </Step>
    </Response>
  </PostFlow>
  <Flows/>
  <HTTPTargetConnection>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
    <Properties>
      <Property name="success.codes">2XX</Property>
      <Property name="io.timeout.millis">120000</Property>
      <Property name="connect.timeout.millis">10000</Property>
    </Properties>
    <LoadBalancer>
      <Algorithm>RoundRobin</Algorithm>
      <Server name="gdcso-vertex-ai"/>
    </LoadBalancer>
    <Path>/v1/projects/{propertyset.hybrid_agents_env.project_id}/locations/{propertyset.hybrid_agents_env.vertex_location}/endpoints/openapi</Path>
  </HTTPTargetConnection>
</TargetEndpoint>
