<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step><Name>ParsePayload-MCP</Name></Step>
      <Step><Name>VerifyAPIKey-1</Name></Step>
      <Step>
        <Name>Quota-PerToolLimit</Name>
        <Condition>(parsepayload.ParsePayload-MCP.json-rpc.request.method = "tools/call") or (parsepayload.ParsePayload-MCP.json-rpc.request.method = "tools/list")</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <HTTPProxyConnection>
    <BasePath>/mcp-bigquery</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
